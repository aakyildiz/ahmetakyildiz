---
import Layout from '../layouts/Layout.astro';
import Sidebar from '../components/Sidebar';
import ExperienceCard from '../components/ExperienceCard';

const experiences = [
  {
    date: "Dec 2022 — Present",
    title: "Frontend Developer",
    company: "Mimosa Networks",
    description: "Working on our enterprise Network Management Platform. After completing the Angular to React migration, I'm now focused on adding new features, modernizing the UI, and reorganizing routes for a cleaner architecture.",
    tech: ["React", "TypeScript", "Redux Toolkit", "ReactFlow", "Google Maps API", "Material-UI", "Vite", "Vitest"]
  },
  {
    date: "Nov 2021 — Dec 2022",
    title: "Manager, SQA Turkey Team",
    company: "Mimosa Networks",
    description: "Managed our Turkey and US-based QA teams during the Wi-Fi 6 product development cycle.",
    tech: ["Cypress", "Team Leadership", "Agile/Scrum", "Wi-Fi 6"]
  },
  {
    date: "Apr 2021 — Nov 2021",
    title: "Software Quality Assurance Turkey Team Lead",
    company: "Mimosa Networks",
    description: "Led the Turkey QA team testing our Wi-Fi 5 products for a major deployment.",
    tech: ["Cypress", "Test Automation", "Wi-Fi 5"]
  },
  {
    date: "Oct 2020 — Apr 2021",
    title: "Senior Software Quality Assurance Engineer",
    company: "Mimosa Networks",
    description: "Set up our Jenkins CI/CD pipeline and automated test infrastructure.",
    tech: ["Jenkins", "CI/CD", "Python", "Test Automation"]
  },
];

const projects = [
  {
    title: "Neighborhood Energy NE",
    link: "https://neighborhoodenergyne.com/",
    description: "A Django-based platform for tracking energy contracts and usage. Helps commercial clients manage their energy suppliers and optimize costs.",
    tech: ["Django", "Python", "PostgreSQL", "Docker", "AWS S3"]
  },
  {
    title: "ChronoSearch",
    link: "https://www.chronosearch.com/",
    description: "A web app for discovering luxury watches. You can upload a photo to identify a watch or test your knowledge with watch trivia.",
    tech: ["Next.js", "TypeScript", "Tailwind CSS", "Framer Motion", "PWA"]
  },
  {
    title: "Text2Test",
    link: "https://research.sabanciuniv.edu/id/eprint/48873/",
    description: "My Master's thesis project — an NLP system that converts plain English test descriptions into executable Android tests. Makes writing automated tests much easier.",
    tech: ["Python", "PyTorch", "NLP", "spaCy", "Appium"]
  }
];
---

<Layout title="Ahmet Akyildiz - Frontend Developer">
    <div class="layout-wrapper">
        <Sidebar client:idle />

        <main class="main-content">
        <!-- About Section -->
        <section id="about" class="section">
            <div class="about-text">
            <p>
                Hey! I'm a frontend developer at <strong><a href="https://mimosa.co/" target="_blank" class="underline-link">Mimosa Networks</a></strong>, where I spend most of my time 
                working on our network management platform. After completing the <strong><a href="https://angular.io/" target="_blank" class="underline-link">Angular</a></strong> to <strong><a href="https://react.dev/" target="_blank" class="underline-link">React</a></strong> 
                migration, I'm now adding new features, modernizing the UI, and reorganizing routes. 
                Before moving into development, I spent about six years in <strong>Software Quality Assurance</strong> and eventually managed our team.
            </p>
            <p>
                The <strong>SQA</strong> background turned out to be pretty useful — there's something about breaking 
                things professionally that makes you better at building them. My Master's on <strong><a href="https://www.deeplearning.ai/resources/natural-language-processing/" target="_blank" class="underline-link">NLP</a></strong> and 
                automated testing is actually what got me into development. These days I'm most 
                comfortable in <strong><a href="https://react.dev/" target="_blank" class="underline-link">React</a></strong> and <strong><a href="https://www.typescriptlang.org/" target="_blank" class="underline-link">TypeScript</a></strong>, though I'll happily pick up whatever gets the 
                job done.
            </p>
            <p>
                When I'm not coding, you'll probably find me training for my next triathlon, hunting 
                for good specialty coffee, or reading about medieval history. Also into skiing and 
                kitesurfing when the weather cooperates.
            </p>
            </div>
        </section>

            <!-- Projects Section -->
            <section id="projects" class="section">
            <h1 class="section-title">Projects</h1>
                {projects.map((project) => (
                <ExperienceCard client:load {...project} />
                ))}
            </section>

        <!-- Experience Section -->
        <section id="experience" class="section">
            <h2 class="section-title">Experience</h2>
            {experiences.map((exp) => (
            <ExperienceCard client:load {...exp} />
            ))}
        </section>

        </main>
    </div>
</Layout>
